{
  "name": "server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "profile:sheets": "tsx scripts/profile-sheets.ts",
    "provision:master": "tsx scripts/provision-master.ts"
  },
  "dependencies": {
    "@tms/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "googleapis": "^161.0.0",
    "pg": "^8.22.0",
    "pino": "^9.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.3",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
