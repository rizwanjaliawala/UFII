# ============================================================
# Utopia TMS — server configuration
# Copy to server/.env and fill in. Never commit the real file.
# ============================================================

NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ------------------------------------------------------------
# Neon Postgres — the application database.
#
# Source sheets stay read-only; every application write lands here
# (containers' user-owned fields, invoices, audit trail, data quality).
#
# IMPORTANT: remove `channel_binding=require` from the string Neon gives
# you. It is a libpq option that node-postgres does not implement, and
# leaving it in makes the connection hang until it times out with no
# useful error. TLS is still enforced via sslmode and pool.ts.
#   Neon gives:  ...neon.tech/neondb?sslmode=require&channel_binding=require
#   Use instead: ...neon.tech/neondb?sslmode=require
# (pool.ts also strips it defensively, so a pasted URL works either way.)
# ------------------------------------------------------------
DATABASE_URL=

# ------------------------------------------------------------
# Edit gate.
#
# Shared confirmation code required to commit any edit. Validated
# SERVER-SIDE only — the client never decides whether a key is valid.
# Prevents accidental edits; it is NOT authentication and cannot
# attribute a change to a person. Replaced by RBAC in Phase 5 (doc 09).
# ------------------------------------------------------------
EDIT_KEY=
EDIT_KEY_MAX_ATTEMPTS=5
EDIT_KEY_LOCKOUT_MINUTES=10

# ------------------------------------------------------------
# Google  (only needed for TMS Master writes and Drive documents;
# the source sheets are read credential-free via CSV export)
# ------------------------------------------------------------
# 1. Google Cloud Console -> create a project
# 2. Enable "Google Sheets API" and "Google Drive API"
# 3. Create a Service Account, add a JSON key, save it to server/secrets/
# 4. Copy the service account address (…iam.gserviceaccount.com) and SHARE:
#      - Source Sheet 1 "Floor-Loaded (USA)"   -> Viewer   (read only)
#      - Source Sheet 2 "Detention"            -> Viewer   (read only)
#      - TMS Master                            -> Editor   (read/write)
#      - The Drive folder of documents         -> Viewer
#    A service account is not a Workspace user; it needs explicit sharing.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=./secrets/google-service-account.json

# ...or supply the credentials inline instead of a key file:
# GOOGLE_CLIENT_EMAIL=tms-sync@your-project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------
# Source sheets — READ ONLY. The application refuses to write to these.
#
# REQUIRED. Deliberately not defaulted in source: these spreadsheets are
# shared "anyone with the link", so committing an ID would publish the
# operational data to anyone who can read this repository.
#
# The ID is the long segment of the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# ------------------------------------------------------------
SOURCE_SHEET_1_ID=
SOURCE_SHEET_2_ID=

# TMS Master — the application database. Create with: npm run provision:master
TMS_MASTER_SHEET_ID=

# Drive folder holding PU screenshots, invoice PDFs, PODs, gate receipts
GOOGLE_DRIVE_FOLDER_ID=

# ------------------------------------------------------------
# Outlook Desktop (Windows COM — no Graph, no OAuth, no passwords)
# ------------------------------------------------------------
OUTLOOK_ENABLED=true
OUTLOOK_INBOX_FOLDER=Inbox
OUTLOOK_ARCHIVE_FOLDER=Archive
OUTLOOK_MAX_ATTACHMENT_MB=25
OUTLOOK_REFRESH_MINUTES=15

# ------------------------------------------------------------
# Synchronization
# ------------------------------------------------------------
SYNC_AUTOMATIC=true
SYNC_INTERVAL_MINUTES=15
SYNC_ON_STARTUP=true
SYNC_RETRY_ATTEMPTS=3
SYNC_MAX_BATCH_SIZE=500

# ------------------------------------------------------------
# OCR — results are NEVER auto-approved; this only flags low confidence
# ------------------------------------------------------------
OCR_LOW_CONFIDENCE=0.75

# ------------------------------------------------------------
# AI — Claude API for the four generative agents.
# Without a key the application still runs, using templated output.
# ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=1024

# ------------------------------------------------------------
# Auth — user records and password hashes live OUTSIDE TMS Master,
# because that sheet is shared to enable the Google integration.
# ------------------------------------------------------------
AUTH_DATA_DIR=./.data
SESSION_TTL_HOURS=12
REMEMBER_ME_DAYS=30
MAX_FAILED_ATTEMPTS=5

CACHE_TTL_MINUTES=30
